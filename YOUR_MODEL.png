<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>My 3D Avatar Portfolio</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            background-color: #1a1a2e; /* Dark background to match your reference style */
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        #canvas-container {
            width: 100vw;
            height: 100vh;
            display: block;
        }
        #loading {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: white;
            font-size: 1.2rem;
            letter-spacing: 2px;
            pointer-events: none;
        }
        /* Optional overlay UI */
        .overlay {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            color: rgba(255, 255, 255, 0.7);
            text-align: center;
            pointer-events: none;
        }
    </style>
    
    <!-- Import Maps for Three.js -->
    <script type="importmap">
        {
            "imports": {
                "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
                "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
            }
        }
    </script>
</head>
<body>

    <div id="loading">Loading Avatar...</div>
    <div id="canvas-container"></div>
    <div class="overlay">
        <p>Drag to rotate | Pinch/Scroll to zoom</p>
    </div>

    <script type="module">
        import * as THREE from 'three';
        import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
        import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

        // 1. Scene Setup
        const container = document.getElementById('canvas-container');
        const scene = new THREE.Scene();
        // Soft radial gradient background
        scene.background = new THREE.Color(0x1a1a2e); 
        scene.fog = new THREE.Fog(0x1a1a2e, 10, 50);

        // 2. Camera Setup
        const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);
        camera.position.set(0, 1.5, 4); // Positioned to look at a standing character

        // 3. Renderer Setup
        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(window.devicePixelRatio);
        renderer.toneMapping = THREE.ACESFilmicToneMapping; // Realistic color grading
        renderer.toneMappingExposure = 1.0;
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
        container.appendChild(renderer.domElement);

        // 4. Lighting Setup (Realistic Studio Lighting)
        // Ambient Light (Fill)
        const hemiLight = new THREE.HemisphereLight(0xffffff, 0x444444, 0.6);
        hemiLight.position.set(0, 20, 0);
        scene.add(hemiLight);

        // Key Light (Main illumination)
        const dirLight = new THREE.DirectionalLight(0xffffff, 1.5);
        dirLight.position.set(3, 5, 5);
        dirLight.castShadow = true;
        dirLight.shadow.camera.top = 2;
        dirLight.shadow.camera.bottom = -2;
        dirLight.shadow.camera.left = -2;
        dirLight.shadow.camera.right = 2;
        dirLight.shadow.camera.near = 0.1;
        dirLight.shadow.camera.far = 20;
        scene.add(dirLight);

        // Back Light (Rim lighting to separate from background)
        const backLight = new THREE.DirectionalLight(0xaabbff, 1);
        backLight.position.set(-3, 4, -5);
        scene.add(backLight);

        // 5. Controls (Rotate, Zoom, Pan via mouse/touch)
        const controls = new OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true; // Smooth inertia
        controls.dampingFactor = 0.05;
        controls.minDistance = 1; // Max zoom in
        controls.maxDistance = 8; // Max zoom out
        controls.target.set(0, 1, 0); // Focus on the middle of the character's body
        controls.maxPolarAngle = Math.PI / 2 + 0.1; // Prevent looking from underneath the floor

        // Optional: Add a subtle floor
        const floorGeometry = new THREE.PlaneGeometry(20, 20);
        const floorMaterial = new THREE.MeshStandardMaterial({ 
            color: 0x111118, 
            roughness: 0.8, 
            metalness: 0.2 
        });
        const floor = new THREE.Mesh(floorGeometry, floorMaterial);
        floor.rotation.x = -Math.PI / 2;
        floor.receiveShadow = true;
        scene.add(floor);

        // 6. Load the .glb Model
        // IMPORTANT: Replace 'YOUR_MODEL.glb' with the actual path to your generated file
        const loader = new GLTFLoader();
        const modelPath = 'YOUR_MODEL.glb'; 

        loader.load(
            modelPath,
            (gltf) => {
                const model = gltf.scene;
                
                // Enable shadows for the model
                model.traverse((child) => {
                    if (child.isMesh) {
                        child.castShadow = true;
                        child.receiveShadow = true;
                    }
                });

                // Center the model dynamically based on its bounding box
                const box = new THREE.Box3().setFromObject(model);
                const center = box.getCenter(new THREE.Vector3());
                const size = box.getSize(new THREE.Vector3());
                
                // Adjust position so feet are on the floor
                model.position.y += (model.position.y - box.min.y);
                
                scene.add(model);
                
                // Update controls target to center of character
                controls.target.set(0, size.y / 2, 0);
                
                // Hide loading text
                document.getElementById('loading').style.display = 'none';
            },
            (xhr) => {
                // Progress tracking
                const percent = (xhr.loaded / xhr.total) * 100;
                document.getElementById('loading').innerText = `Loading... ${Math.round(percent)}%`;
            },
            (error) => {
                console.error('An error occurred loading the model:', error);
                document.getElementById('loading').innerText = 'Error loading model. Make sure you replaced "YOUR_MODEL.glb" with your actual file path.';
            }
        );

        // 7. Handle Window Resize
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        // 8. Animation Loop
        function animate() {
            requestAnimationFrame(animate);
            controls.update(); // Required for damping
            renderer.render(scene, camera);
        }

        animate();
    </script>
</body>
</html>

